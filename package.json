{
  "name": "gw2-combat-simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node server.mjs",
    "pretest": "npm run build",
    "test": "node --import ./scripts/register-dist-loader.mjs --test --test-isolation=none",
    "typecheck": "tsc -p jsconfig.typed.json",
    "check": "npm run build && npm run typecheck && node scripts/check-js.mjs && node scripts/check-dist.mjs",
    "update:profession-data": "node scripts/update-profession-api-data.mjs",
    "update:mesmer-data": "node scripts/update-mesmer-api-data.mjs",
    "update:guardian-data": "node scripts/update-guardian-api-data.mjs",
    "update:necromancer-data": "node scripts/update-necromancer-api-data.mjs",
    "generate:revenant-ids": "node scripts/generate-revenant-ids.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
