{
  "name": "gw2-combat-simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/build/clean-dist.mjs",
    "build": "npm run clean && npm run build:modules && npm run build:site",
    "build:dev": "npm run clean && npm run build:modules && npm run build:site -- --mode development",
    "build:modules": "tsc -p tsconfig.build.json",
    "build:site": "vite build",
    "prestart": "npm run build:dev",
    "start": "node server.mjs",
    "preauthor:patch-preview": "npm run build:dev",
    "author:patch-preview": "node --import ./scripts/testing/register-dist-loader.mjs scripts/patch-preview-authoring-server.mjs",
    "pretest": "npm run build",
    "test": "node --import ./scripts/testing/register-dist-loader.mjs --test --test-isolation=none",
    "typecheck": "tsc -p jsconfig.typed.json",
    "check": "npm run build && npm run typecheck && node scripts/build/check-js.mjs && node scripts/build/check-dist.mjs && node scripts/build/check-site.mjs",
    "update:profession-data": "node scripts/data/update-profession-api-data.mjs",
    "update:build-template-data": "node scripts/data/update-build-template-data.mjs",
    "update:elementalist-data": "node scripts/data/update-elementalist-api-data.mjs",
    "update:warrior-data": "node scripts/data/update-warrior-api-data.mjs && node scripts/data/generate-warrior-data.mjs",
    "update:ranger-data": "node scripts/data/update-profession-api-data.mjs --profession Ranger && node scripts/data/generate-ranger-ids.mjs && node scripts/data/generate-ranger-pet-data.mjs && node scripts/data/generate-ranger-skill-mechanics.mjs",
    "generate:revenant-ids": "node scripts/data/generate-revenant-ids.mjs",
    "patch-preview:report": "npm run build:modules && node --import ./scripts/testing/register-dist-loader.mjs scripts/patch-preview-report.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
