{
  "name": "gw2-combat-simulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#gw2/*": {
      "types": "./js/games/gw2/*",
      "browser": "./js/games/gw2/*",
      "default": "./dist/js/games/gw2/*"
    },
    "#kernel/*": {
      "types": "./js/kernel/*",
      "browser": "./js/kernel/*",
      "default": "./dist/js/kernel/*"
    },
    "#ui/*": {
      "types": "./js/ui/*",
      "browser": "./js/ui/*",
      "default": "./dist/js/ui/*"
    },
    "#app/*": {
      "types": "./js/app/*",
      "browser": "./js/app/*",
      "default": "./dist/js/app/*"
    }
  },
  "//": "Scripts are ordered by responsibility: local development, builds, validation, analysis and authoring, then data maintenance.",
  "scripts": {
    "dev": "vite",
    "prestart": "npm run build:dev",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "clean": "node scripts/build/clean-dist.mjs",
    "build": "npm run clean && npm run build:modules && npm run build:site",
    "build:github-pages": "npm run clean && npm run build:modules && npm run build:site -- --mode github-pages",
    "build:dev": "npm run clean && npm run build:modules && npm run build:site -- --mode development",
    "build:modules": "tsc -p tsconfig.build.json",
    "build:site": "vite build",
    "pretest": "npm run build",
    "test": "node --import ./scripts/testing/register-dist-loader.mjs --test --test-isolation=none",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check": "npm run format:check && npm run lint && npm run build && npm run typecheck && node scripts/build/check-js.mjs && node scripts/build/check-dist.mjs && node scripts/build/check-site.mjs && npm run test:browser",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "benchmarks:compare": "npm run build:modules && node --import ./scripts/testing/register-dist-loader.mjs scripts/analysis/compare-supported-build-dps.mjs",
    "preauthor:patch-preview": "npm run build:dev",
    "author:patch-preview": "node --import ./scripts/testing/register-dist-loader.mjs scripts/patch-preview/patch-preview-authoring-server.mjs",
    "patch-preview:report": "npm run build:modules && node --import ./scripts/testing/register-dist-loader.mjs scripts/patch-preview/patch-preview-report.mjs",
    "update:profession-data": "node scripts/data/update-profession-data.mjs",
    "update:build-template-data": "node scripts/data/update-build-template-data.mjs",
    "update:elementalist-data": "node scripts/data/update-elementalist-api-data.mjs",
    "update:warrior-data": "node scripts/data/update-warrior-data.mjs",
    "update:ranger-data": "node scripts/data/update-ranger-data.mjs",
    "generate:revenant-ids": "npm run build:modules && node --import ./scripts/testing/register-dist-loader.mjs scripts/data/generate-revenant-ids.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
