{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "js/**/*.ts",
    "tests/typecheck/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
