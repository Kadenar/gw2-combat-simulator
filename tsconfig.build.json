{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false
  },
  "include": [
    "js/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
