{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": false,
    "removeComments": false
  },
  "include": ["js/**/*.ts", "js/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
